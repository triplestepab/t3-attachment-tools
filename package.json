{
    "name": "t3-attachment-tools",
    "version": "1.0.7",
    "author": "Tomas Nilsson",
    "description": "Attachment tools plugin for Obsidian",
    "repository": {
        "type": "git",
        "url": "https://github.com/triplestepab/t3-attachment-tools"
    },
    "private": true,
    "type": "module",
    "main": "main.js",
    "scripts": {
