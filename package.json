        "esbuild": "^0.28.2",
        "obsidian": "^1.14.4",
        "oxfmt": "^0.79.0",
        "oxlint": "^1.94.0",
        "typescript": "6.0.3",
        "eslint": "^9.39.5",
        "eslint-plugin-obsidianmd": "^0.6.0"
    },
    "dependencies": {}
}
